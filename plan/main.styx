name tisutil

source {
    url "git@github.com:divvun/tisutil.git"
    ref main
}

children (
    {
        id kit
        title "TISKit library"
        kind @feat
        children (
            {
                id kit.package
                title "SwiftPM package: TISKit library and tisutil executable (swift-argument-parser, macOS 13)"
                priority 0
                kind @build
                sealed true
                log (
                    {
                        at 2026-10-19T11:49:52.266833Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-10-19T11:55:40.062771Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id kit.model
                title "Input source snapshot, category/type mapping, typed TIS errors"
                priority 0
                implements {
                    swift (
                        [spec:tis:def:kit.input-source]
                        [spec:tis:req:kit.property-snapshot]
                        [spec:tis:req:kit.category-type]
                        [spec:tis:req:kit.errors]
                    )
                }
                deps (kit.package)
                log (
                    {
                        at 2026-10-19T11:55:43.133334Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id kit.enumerate
                title "List with filters, current sources, lookup by ID"
                priority 0
                implements {
                    swift (
                        [spec:tis:req:kit.list]
                        [spec:tis:req:kit.current]
                        [spec:tis:req:kit.lookup]
                        [spec:tis:req:kit.main-thread]
                    )
                }
                deps (kit.model)
                log (
                    {
                        at 2026-10-19T11:58:31.003969Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }
        )
    }

    {
        id cli
        title "Command-line conventions: output modes, JSON shape, exit codes"
        priority 0
        kind @feat
        implements {
            swift ([spec:tis:req:cli.output-modes] [spec:tis:req:cli.json-shape] [spec:tis:req:cli.exit-codes])
        }
        deps (kit.model)
        log (
            {
                at 2026-10-19T11:56:43.416607Z
                author "brendan@necessary.nu"
                kind @status
                text "Todo → Doing (nplan start)"
            }
        )
    }

    {
        id query
        title "Query commands: list, current, show"
        priority 0
        kind @feat
        implements {
            swift ([spec:tis:req:query.list] [spec:tis:req:query.current] [spec:tis:req:query.show])
        }
        deps (kit.enumerate cli)
        log (
            {
                at 2026-10-19T12:04:46.150058Z
                author "brendan@necessary.nu"
                kind @status
                text "Todo → Doing (nplan start)"
            }
        )
    }

    {
        id mutate
        title "State commands"
        kind @feat
        children (
            {
                id mutate.state
                title "enable / disable / select / deselect, with post-change verification"
                priority 1
                implements {
                    swift ([spec:tis:req:mutate.enable-disable] [spec:tis:req:mutate.select] [spec:tis:req:mutate.verify])
                }
                deps (kit.enumerate cli)
                log (
                    {
                        at 2026-10-19T12:12:01.32594Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id mutate.layout-override
                title "Get and set the input method keyboard layout override"
                priority 2
                implements {
                    swift ([spec:tis:req:mutate.layout-override])
                }
                deps (kit.enumerate cli)
                log (
                    {
                        at 2026-10-19T13:38:50.57878Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id mutate.force-enable-spec
                title "Specify explicit force enablement through the private TIS API"
                kind @docs
                deps (mutate.state install.place)
                sealed true
                log (
                    {
                        at 2026-10-19T13:07:07.574262Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-10-19T13:07:08.027882Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id mutate.force-enable
                title "Add explicit --force enablement without the macOS approval sheet"
                kind @feat
                implements {
                    swift ([spec:tis:req:mutate.force-enable])
                }
                deps (mutate.force-enable-spec)
                log (
                    {
                        at 2026-10-19T13:07:08.183409Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-10-19T13:10:03.620058Z
                        author "brendan@necessary.nu"
                        kind @decision
                        text "The operator opted in to force enablement after the investigation recorded in 2026-10-19-150523-nplan-init-swift-tisutil-is-a-command-line-tool.txt. Expose it as --force for enable and activation steps; keep normal enablement as the default. README and command help describe skipping the approval sheet without API implementation details, as requested."
                    }
                )
            }
        )
    }

    {
        id session
        title "User sessions for root callers"
        kind @feat
        children (
            {
                id session.reexec
                title "Console user detection, re-exec via launchctl asuser, privilege checks"
                priority 1
                implements {
                    swift ([spec:tis:req:session.console-user] [spec:tis:req:session.reexec] [spec:tis:req:session.privilege])
                }
                deps (cli)
                log (
                    {
                        at 2026-10-19T12:19:05.158213Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id session.prefs-fallback
                title "Enable/disable through HIToolbox preferences when the user has no session"
                priority 2
                implements {
                    swift ([spec:tis:req:session.prefs-fallback])
                }
                deps (session.reexec mutate.state)
                log (
                    {
                        at 2026-10-19T12:47:47.440409Z
                        author "brendan@necessary.nu"
                        kind @blocker
                        text "The rule as written cannot hold on macOS 26. Third-party input sources are recorded as enabled in com.apple.inputsources AppleEnabledThirdPartyInputSources, not com.apple.HIToolbox AppleEnabledInputSources, and enabling one through TIS raises a prompt that the user must allow. Writing that preference for a user who is not logged in would skip their consent. The rule needs redesigning (for example, only Apple sources, or defer the enable to the user's next login) before this node is built."
                    }
                )
            }
        )
    }

    {
        id install
        title "Registration and installation"
        kind @feat
        children (
            {
                id install.register
                title "Detect item kind and register it with TIS"
                priority 1
                implements {
                    swift ([spec:tis:req:install.kind-detect] [spec:tis:req:install.register])
                }
                deps (kit.enumerate cli)
                log (
                    {
                        at 2026-10-19T12:20:53.107731Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id install.place
                title "Copy into Keyboard Layouts / Input Methods, then register and optionally enable"
                priority 1
                implements {
                    swift ([spec:tis:req:install.place] [spec:tis:req:install.enable])
                }
                deps (install.register mutate.state session.reexec)
                log (
                    {
                        at 2026-10-19T12:24:23.268433Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }
        )
    }

    {
        id watch
        title "Watch selection and enablement changes"
        priority 2
        kind @feat
        implements {
            swift ([spec:tis:req:watch.stream] [spec:tis:req:watch.json-lines])
        }
        deps (kit.enumerate cli)
        log (
            {
                at 2026-10-19T13:37:02.904309Z
                author "brendan@necessary.nu"
                kind @status
                text "Todo → Doing (nplan start)"
            }
        )
    }

    {
        id docs
        title "README and AGENTS guide"
        kind @docs
        deps (
            query
            mutate.state
            session.reexec
            install.place
        )
        sealed true
        log (
            {
                at 2026-10-19T12:48:32.835479Z
                author "brendan@necessary.nu"
                kind @status
                text "Todo → Doing (nplan start)"
            }

            {
                at 2026-10-19T12:48:55.117935Z
                author "brendan@necessary.nu"
                kind @status
                text "Doing → Done (nplan complete)"
            }
        )
    }
)
